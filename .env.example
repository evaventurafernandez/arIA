POSTGRES_HOST=127.0.0.1
POSTGRES_DB=meteovisor
POSTGRES_USER=meteovisor
POSTGRES_PASSWORD=meteovisor
POSTGRES_PORT=5432
FIRMS_MAP_KEY=
FIRMS_HISTORICAL_DEFAULT_DATE_FROM=2025-05-01
FIRMS_HISTORICAL_DEFAULT_DATE_TO=2025-08-31
AEMET_API_KEY=
AEMET_WARNINGS_DEFAULT_DATE_FROM=2025-05-01
AEMET_WARNINGS_DEFAULT_DATE_TO=2025-08-31
BURNT_AREA_CATALOG_ROOT=data/copernicus/data_burnt_areas
# Opcional: alternativa al directorio extraído
BURNT_AREA_CATALOG_ZIP=
# Opcional: credenciales CDSE para descargar COG remotos durante la ingesta
CDSE_USERNAME=
CDSE_PASSWORD=
# Opcional: si ya tienes claves S3 temporales o persistentes
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
CDSE_S3_ENDPOINT=eodata.dataspace.copernicus.eu

# Chat LLM (Fase 0)
# Endpoint OpenAI-compatible, incluyendo la ruta /v1/chat/completions.
# Ejemplos: vLLM (http://host:30000/v1/chat/completions), Ollama remoto (https://.../v1/chat/completions).
LLM_API_URL=
# Opcional. Si el servidor no exige autenticación (vLLM local, Ollama sin token), dejar en blanco
# y no se enviará la cabecera Authorization.
LLM_API_KEY=
# Identificador exacto del modelo según /v1/models del servidor. Ejemplos: google/gemma-4-26B-A4B-it, qwen3.6:35b-a3b.
LLM_MODEL=
LLM_MAX_TOOL_ITERATIONS=8
LLM_REQUEST_TIMEOUT=120
