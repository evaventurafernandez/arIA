CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
CDSE_S3_ENDPOINT=eodata.dataspace.copernicus.eu

# Chat LLM (Fase 0)
# Endpoint OpenAI-compatible expuesto por el Ollama remoto, incluyendo /v1/chat/completions.
LLM_API_URL=
# Token generado en la interfaz web del Ollama remoto. Se envía como Authorization: Bearer <token>.
LLM_API_KEY=
LLM_MODEL=qwen3.6:35b-a3b
LLM_MAX_TOOL_ITERATIONS=8
LLM_REQUEST_TIMEOUT=120
